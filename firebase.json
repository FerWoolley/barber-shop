{
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "storage": { "rules": "storage.rules" },
  "functions": [{ "source": "functions", "codebase": "barber-shop", "runtime": "nodejs22" }],
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firestore.*", "storage.rules", "**/.*", "**/node_modules/**", "functions/**", "scripts/**", "FIREBASE.md", "**/*credentials*.json", "**/local-export*.json", "**/test/**"],
    "headers": [
      { "source": "**/*.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] }
    ]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "functions": { "port": 5001 },
    "storage": { "port": 9199 },
    "singleProjectMode": true
  }
}
